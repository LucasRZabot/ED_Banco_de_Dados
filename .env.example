# Copie para `.env` e ajuste. Nunca versione o `.env`.

# ── App ──
APP_URL=http://localhost:3000
APP_TIMEZONE=America/Sao_Paulo
ALERT_WARNING_DAYS=5

# ── PostgreSQL ──
# Dev: docker compose (serviço `postgres`). No Cursor publish-app a plataforma define DATABASE_URL.
POSTGRES_USER=financeiro
POSTGRES_PASSWORD=financeiro
POSTGRES_DB=financeiro
DATABASE_URL=postgresql://financeiro:financeiro@localhost:5432/financeiro?schema=public

# ── Auth.js v5 ──
# Gere com: npx auth secret   (ou: openssl rand -base64 32)
# Sem AUTH_SECRET o app não inicia em produção.
AUTH_SECRET=
AUTH_TRUST_HOST=true
# Duração da sessão em horas
AUTH_SESSION_MAX_AGE_HOURS=10

# Código de uma vez para o primeiro ADMIN (TI). Mínimo 16 caracteres. Só a TI deve conhecê-lo.
BOOTSTRAP_SECRET=

# Contas do seed local (`npm run db:seed`). Não use em produção. Preencha só no `.env`.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_FINANCEIRO_EMAIL=
SEED_FINANCEIRO_PASSWORD=
SEED_REQUESTER_EMAIL=
SEED_REQUESTER_PASSWORD=

# ── Uploads ──
# Arquivos vão para Postgres (bytea), sem S3/Firebase. Máximo por arquivo:
UPLOAD_MAX_SIZE_MB=15

# ── Cron ──
# Scheduler diário: POST /api/cron/check-deadlines
# Header obrigatório: Authorization: Bearer <CRON_SECRET>  (sem o header → 401)
CRON_SECRET=
