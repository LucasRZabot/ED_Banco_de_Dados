# Copie para `.env` e ajuste. Nunca versione o `.env`.

# ── App ──
APP_URL=http://localhost:3000
APP_TIMEZONE=America/Sao_Paulo
ALERT_WARNING_DAYS=5

# ── PostgreSQL ──
# Dev: docker compose (serviço `postgres`). Prod: Neon/Cloud SQL com ?sslmode=require
POSTGRES_USER=financeiro
POSTGRES_PASSWORD=financeiro
POSTGRES_DB=financeiro
DATABASE_URL=postgresql://financeiro:financeiro@localhost:5432/financeiro?schema=public

# ── Auth.js v5 ──
# Gere com: npx auth secret   (ou: openssl rand -base64 32)
AUTH_SECRET=troque-por-um-valor-aleatorio-de-32-bytes
AUTH_TRUST_HOST=true
# Duração da sessão em horas
AUTH_SESSION_MAX_AGE_HOURS=10

# Contas criadas pelo seed (somente dev; troca de senha obrigatória no 1º acesso)
SEED_ADMIN_EMAIL=admin@hospital.local
SEED_ADMIN_PASSWORD=Admin@123456
SEED_FINANCEIRO_EMAIL=financeiro@hospital.local
SEED_FINANCEIRO_PASSWORD=Financeiro@123456
SEED_REQUESTER_EMAIL=chefia.uti@hospital.local
SEED_REQUESTER_PASSWORD=Chefia@123456

# ── Armazenamento ──
# Dev: s3 (moto no docker compose). Prod (Firebase App Hosting): gcs — pode omitir
# STORAGE_PROVIDER e GCS_BUCKET; o App Hosting injeta FIREBASE_CONFIG.storageBucket.
STORAGE_PROVIDER=s3
STORAGE_PRESIGN_EXPIRES_SECONDS=300
UPLOAD_MAX_SIZE_MB=15

# S3 local (moto). Ignorado quando STORAGE_PROVIDER=gcs.
AWS_REGION=us-east-1
S3_BUCKET=hospital-financeiro-anexos
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_ENDPOINT=http://localhost:4566
S3_FORCE_PATH_STYLE=true

# Firebase Storage (produção). Vazio em dev.
# GCS_BUCKET=seu-projeto.firebasestorage.app

# ── Cron ──
# Cloud Scheduler diário: POST /api/cron/check-deadlines
# Header obrigatório: Authorization: Bearer <CRON_SECRET>  (sem o header → 401)
CRON_SECRET=troque-por-um-valor-longo-aleatorio

# ── Produção (ver docs/deploy.md) ──
# DATABASE_URL, AUTH_SECRET e CRON_SECRET vão para Firebase App Hosting → Secrets
# (Cloud Secret Manager), nunca para o git. Seed (SEED_*) não roda em produção.
# Health: GET /api/health  e  GET /api/health?deep=1
